# Optional settings for the TypeScript prototype (server.ts).
# All have defaults, so the prototype runs without a .env file.
# The app needs no API keys: it only talks to a local Ollama server.
# Copy to .env to override. Never commit .env.

# OLLAMA_URL: where the local Ollama server listens.
OLLAMA_URL="http://localhost:11434"

# MODEL: the Ollama model tag (team choice: gemma4:e2b).
MODEL="gemma4:e2b"

# PORT: port the prototype's web server listens on.
PORT="3000"
